      "Instalaciones privadas : 3,032\n",
      "Instalaciones públicas :   599\n",
      "Total                  : 3,631\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mticker\n",
    "import seaborn as sns\n",
    "from scipy.spatial.distance import cdist\n",
    "from scipy.spatial import cKDTree\n",
    "\n",
    "# Paleta de colores consistente con el estilo del curso\n",
    "MAGENTA = \"#ecc47e\"\n",
    "AZUL    = \"#3222A6\"\n",
    "GRIS    = \"#BDBDBD\"\n",
    "NARANJA = \"#E68200\"\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"figure.dpi\": 120,\n",
    "    \"axes.spines.top\": False,\n",
    "    \"axes.spines.right\": False,\n",
    "    \"axes.grid\": True,\n",
    "    \"grid.alpha\": 0.3,\n",
    "    \"font.size\": 11,\n",
    "})\n",
    "\n",
    "# ----- Carga -----\n",
    "priv = pd.read_excel(\"C:\\\\Users\\\\Lenovo\\\\infovis\\\\InfoVis\\\\datasets\\\\PRIVADAS.xlsx\", parse_dates=False)\n",
    "pub  = pd.read_excel(\"C:\\\\Users\\\\Lenovo\\\\infovis\\\\InfoVis\\\\datasets\\\\PÚBLICAS.xlsx\",  parse_dates=False)\n",
    "\n",
    "# Parsear fechas manualmente (formato DD-MM-YYYY)\n",
    "for df in (priv, pub):\n",
    "    df[\"FECHA\"] = pd.to_datetime(df[\"FECHA_INSCRIPCIÓN\"], dayfirst=True, errors=\"coerce\")\n",
    "    df[\"AÑO\"]   = df[\"FECHA\"].dt.year\n",
    "\n",
    "print(f\"Instalaciones privadas : {len(priv):>5,}\")\n",
    "print(f\"Instalaciones públicas : {len(pub):>5,}\")\n",
    "print(f\"Total                  : {len(priv)+len(pub):>5,}\")"
   ]
  },
